{
  "name": "vorqul-ds-bot",
  "version": "1.0.0",
  "description": "Modern modular Discord bot with web dashboard - by Yamiru",
  "author": "Yamiru",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://vorqul.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yamiru/Vorqul-DS-BOT.git"
  },
  "bugs": {
    "url": "https://github.com/Yamiru/Vorqul-DS-BOT/issues"
  },
  "type": "module",
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "dev": "concurrently \"npm run dev:bot\" \"npm run dev:dashboard\"",
    "dev:bot": "tsx watch src/bot/index.ts",
    "dev:dashboard": "next dev src/dashboard -p 3000",
    "build": "npm run build:bot && npm run build:dashboard && npm run copy:locales",
    "build:bot": "npm run clean:bot && tsc -p tsconfig.bot.json",
    "build:dashboard": "next build src/dashboard",
    "copy:locales": "cp -r src/locales dist/ 2>/dev/null || mkdir -p dist/locales && cp src/locales/*.json dist/locales/",
    "start:bot": "node dist/bot/index.js",
    "start:dashboard": "next start src/dashboard -p 3000",
    "start:all": "concurrently \"npm run start:bot\" \"npm run start:dashboard\"",
    "lint": "eslint .",
    "clean:bot": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.bot.json --noEmit",
    "update": "npm update && npm run build:bot && npm test",
    "outdated": "npm outdated || true",
    "lint:fix": "eslint . --fix",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:sync": "node scripts/i18n.mjs sync",
    "i18n:add": "node scripts/i18n.mjs add",
    "i18n:missing": "node scripts/i18n.mjs missing",
    "seal": "node scripts/seal.mjs",
    "seal:check": "node scripts/seal.mjs --check"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.58",
    "axios": "^1.6.7",
    "cron": "^3.1.6",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "ms": "^2.1.3",
    "mysql2": "^3.9.0",
    "next": "^15.5.22",
    "next-auth": "^4.24.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.19.27",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^10.0.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "postcss": "^8.5.18"
  }
}
