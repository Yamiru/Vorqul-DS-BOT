{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["./src/config/*"],
      "@utils/*": ["./src/utils/*"],
      "@shared/*": ["./src/shared/*"],
      "@locales/*": ["./src/locales/*"]
    }
  },
  "include": ["src/bot/**/*", "src/config/**/*", "src/shared/**/*", "src/utils/**/*", "src/locales/**/*"],
  "exclude": ["node_modules", "dist", "src/dashboard"]
}
