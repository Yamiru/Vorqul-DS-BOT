# =========================================================================
# Vorqul DS BOT - Env
# https://vorqul.com
# https://github.com/Yamiru/Vorqul-DS-BOT
# Author: Yamiru
# =========================================================================
# Copy this file to ".env" and fill in your own values:
#   cp .env.example .env
# Never commit your real .env - it's already git-ignored on purpose.

# ---- Discord application ------------------------------------------------
# Bot token from https://discord.com/developers/applications (Bot > Reset Token).
# Treat it like a password: never share it or commit it anywhere public.
DISCORD_TOKEN=
# Application (Client) ID - needed for slash command registration and dashboard login.
DISCORD_CLIENT_ID=
# OAuth2 Client Secret (OAuth2 > Reset Secret). Only needed if the dashboard is enabled.
DISCORD_CLIENT_SECRET=

# ---- Database -----------------------------------------------------------
# Storage backend: json | mysql
# "json" is the default and needs no extra setup. "mysql" makes more sense
# once a server grows, or if you're already running a MySQL/MariaDB instance
# anyway.
# Note: this only affects runtime data (economy, moderation logs, tickets,
# giveaways, and so on). Per-server settings - prefix, language, modules,
# automod/antiraid, welcome messages, everything configured through /settings
# or the dashboard - always live in <DATA_PATH>/json/guild_settings.json,
# regardless of DATABASE_TYPE.
DATABASE_TYPE=json

# MySQL / MariaDB settings (only used when DATABASE_TYPE=mysql).
# Some hosting panels inject their own MYSQL_HOST/PORT/USER/PASSWORD/DATABASE
# variables - if those exist, they're used as a fallback for whatever you
# leave blank below.
DB_HOST=localhost
DB_PORT=3306
DB_USER=vorqul
DB_PASSWORD=
DB_NAME=vorqul

# Folder where JSON data lives (per-server settings always end up here,
# no matter which DATABASE_TYPE you picked above).
DATA_PATH=./data

# ---- Web dashboard ------------------------------------------------------
# Turn the optional web dashboard on or off.
DASHBOARD_ENABLED=true
# Port the dashboard listens on. Leave empty on Pterodactyl to reuse the allocated port.
DASHBOARD_PORT=3000
# Public URL of the dashboard, used for the OAuth2 redirect (must match Discord settings).
# Leave EMPTY to auto-detect it from each request, so the same install works over
# http or https, on an IP, an IP:port or a domain. Every address you use must be
# added as a redirect (<address>/api/auth/callback/discord) in the Discord developer portal.
NEXTAUTH_URL=
# Random secret that signs sessions. Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Optional shared password in front of the whole dashboard (including the Discord
# sign-in). If set, visitors have to type this once before they even reach the
# login screen. The browser remembers it for 30 days after that. Leave empty to
# skip this extra layer entirely - just the normal Discord sign-in then.
DASHBOARD_PASSWORD=

# Instance name (optional). Shown in front of the product name on the login/gate
# screens and in the sidebar, e.g. "My Community · Vorqul DS BOT". The Vorqul DS BOT
# name and vorqul.com link always stay (replacing them needs a commercial license).
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=

# Premium allowlist (optional). Comma-separated guild IDs that always get the top
# "pro" tier and its limits. Everyone else defaults to "free" - grant tiers at
# runtime with the owner-only /premium command.
PREMIUM_GUILDS=

# Dashboard access allowlist (the email tied to the Discord login account).
# If set (comma-separated emails), only these accounts can sign in and manage
# or add servers. Leave empty and there's no restriction - anyone can sign in.
ALLOWED_EMAILS=
# Same idea, but by Discord user ID instead of email - works exactly like
# ALLOWED_EMAILS, and the two lists combine (either one matching is enough).
ALLOWED_IDS=
# Even with ALLOWED_EMAILS/ALLOWED_IDS set, someone outside both lists can still
# sign in if they manage at least one server the bot is actually in (Discord
# Admin/Manage Server, or that server's configured Manager role) - they'll only
# ever reach the servers they actually run, nothing more.
# Message shown to an unauthorized account when it tries to sign in.
AUTH_DENIED_MESSAGE=Your account is not authorized to access this dashboard. Please contact the administrator.

# ---- Bot behaviour ------------------------------------------------------
# Prefix for legacy text commands.
BOT_PREFIX=!
# Default bot language: en, sk, cs, de, pl, ru, es, ja, tr.
BOT_LANGUAGE=en
# Your own Discord user ID - unlocks owner-only commands and lets you install,
# enable, disable, uninstall and configure plugins from the dashboard. More
# than one owner? Comma-separate the IDs.
BOT_OWNER_ID=

# ---- Optional integrations ---------------------------------------------
# Twitch live notifications (optional).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Runtime ------------------------------------------------------------
# "production" on a live server, "development" while you're testing locally.
NODE_ENV=production

# Discord caps you at 100 global slash commands. List any you don't want
# cluttering the slash menu here, comma-separated - they still work through
# the prefix (!command).
DISABLED_COMMANDS=

# ---- Logging --------------------------------------------------------------
# Write logs to a file, with rotation. Without this, only the console gets
# them - and that's gone the moment the process restarts on most hosting.
LOG_TO_FILE=true

# Folder for the log files. Defaults to <DATA_PATH>/logs.
LOG_DIR=

# Size in MB at which a log file rotates to bot.log.1, .2, and so on.
LOG_MAX_SIZE=5

# How many rotated files to keep - older ones get deleted.
LOG_MAX_FILES=5

# How many of the launcher's own archived logs (logs/*.tar.gz, from start.js)
# to keep - older ones get deleted. Separate setting from LOG_MAX_FILES above.
MAX_LOGS=10

# Optional error reporting to Sentry. The package isn't a project dependency -
# if you set a DSN, install it yourself first: npm install @sentry/node
# Without a DSN, errors just go to the console and the log file as usual.
SENTRY_DSN=
SENTRY_RELEASE=
